#!/usr/bin/env bash
set -euo pipefail

pointer="${1:-https://buildinpublicuniversity.com/}"
base="http://127.0.0.1:8787"

printf '\n=== HumAIn / Omarchy ARM Lab demo ===\n'
printf 'pointer: %s\n\n' "$pointer"

printf '%s\n' '[1/3] Loopback adapter health'
curl -fsS "$base/healthz"
printf '\n\n'

printf '%s\n' '[2/3] Valid public-pointer resolution'
valid_json=$(python3 -c 'import json,sys; print(json.dumps({"pointer":sys.argv[1],"requester":"arm-lab-demo"}))' "$pointer")
curl -fsS -X POST "$base/v1/context" \
  -H 'Content-Type: application/json' \
  --data-binary "$valid_json" | python3 -m json.tool
printf '\n'

printf '%s\n' '[3/3] Boundary rejection: query string'
set +e
status=$(curl -sS -o /tmp/humain-demo-reject.json -w '%{http_code}' \
  -X POST "$base/v1/context" \
  -H 'Content-Type: application/json' \
  --data-binary "{\"pointer\":\"${pointer}?demo=forbidden\"}")
set -e
printf 'HTTP status: %s\n' "$status"
cat /tmp/humain-demo-reject.json | python3 -m json.tool

if [[ "$status" != 422 ]]; then
  printf '\nFAIL: expected HTTP 422 boundary rejection\n' >&2
  exit 1
fi

printf '\n%s\n' 'PASS: public-only resolution and query-string rejection are both verified.'
